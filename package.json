{
	"name": "quello-monorepo",
	"version": "0.1.2",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"scripts": {
		"build": "pnpm -r --filter \"./packages/*\" build",
		"dev": "pnpm -r --parallel --filter \"./packages/*\" dev",
		"test": "pnpm -r --filter \"./packages/*\" test",
		"typecheck": "pnpm -r exec tsc --noEmit",
		"play:vue": "pnpm --filter playground-vue dev",
		"play:react18": "pnpm --filter playground-react18 dev",
		"play:react19": "pnpm --filter playground-react19 dev",
		"play:svelte": "pnpm --filter playground-svelte dev",
		"play:solid": "pnpm --filter playground-solid dev",
		"play:nuxt3": "pnpm --filter playground-nuxt3 dev",
		"play:nuxt4": "pnpm --filter playground-nuxt4 dev",
		"play:sveltekit": "pnpm --filter playground-sveltekit dev",
		"play:astro": "pnpm --filter playground-astro dev",
		"play:next15": "pnpm --filter playground-next15 dev",
		"play:next16": "pnpm --filter playground-next16 dev",
		"play:webpack": "pnpm --filter playground-webpack dev",
		"play:angular": "pnpm --filter playground-angular dev",
		"play:vanilla": "pnpm --filter playground-vanilla dev",
		"docs:dev": "pnpm --filter quello-docs dev",
		"docs:build": "pnpm --filter quello-docs build"
	},
	"devDependencies": {
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Linko91/quello.git"
	},
	"homepage": "https://quello-docs.vercel.app"
}