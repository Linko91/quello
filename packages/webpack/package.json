{
	"name": "webpack-plugin-quello",
	"version": "0.1.2",
	"description": "Webpack plugin that injects quello, the visual element picker for AI coding agents.",
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"webpack-plugin",
		"quello",
		"ai",
		"devtools"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@quello/core": "workspace:^",
		"@quello/server": "workspace:^"
	},
	"peerDependencies": {
		"webpack": "^5.0.0"
	},
	"devDependencies": {
		"@types/node": "^26.4.0",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11",
		"webpack": "^5.110.2"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Linko91/quello.git",
		"directory": "packages/webpack"
	},
	"homepage": "https://quello-docs.vercel.app",
	"funding": "https://github.com/sponsors/Linko91",
	"bugs": {
		"url": "https://github.com/Linko91/quello/issues"
	}
}