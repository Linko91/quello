{
  "name": "webpack-plugin-quello",
  "version": "0.1.1",
  "description": "Webpack plugin that injects quello, the visual element picker for AI coding agents.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "webpack-plugin",
    "quello",
    "ai",
    "devtools"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@quello/core": "workspace:^",
    "@quello/server": "workspace:^"
  },
  "peerDependencies": {
    "webpack": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "webpack": "^5.97.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linko91/quello.git",
    "directory": "packages/webpack"
  },
  "homepage": "https://quello-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/Linko91/quello/issues"
  }
}
