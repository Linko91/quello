{
	"name": "@quello/next",
	"version": "0.1.2",
	"description": "Next.js integration for quello, the visual element picker for AI coding agents.",
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./config": {
			"types": "./dist/config.d.ts",
			"import": "./dist/config.js",
			"require": "./dist/config.cjs"
		},
		"./route": {
			"types": "./dist/route.d.ts",
			"import": "./dist/route.js",
			"require": "./dist/route.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"next",
		"nextjs",
		"quello",
		"ai",
		"devtools"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run"
	},
	"dependencies": {
		"@quello/core": "workspace:^",
		"@quello/server": "workspace:^"
	},
	"peerDependencies": {
		"next": "^14.0.0 || ^15.0.0 || ^16.0.0",
		"react": "^18.2.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Linko91/quello.git",
		"directory": "packages/next"
	},
	"homepage": "https://quello-docs.vercel.app",
	"bugs": {
		"url": "https://github.com/Linko91/quello/issues"
	}
}